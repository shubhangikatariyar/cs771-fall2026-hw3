# Submit from repo root: condor_submit chtc/mnist_ddpm_unet.sub
# Needs hw3_code.tar.gz in the repo root: tar czf hw3_code.tar.gz code pretrained
# and a chtc_logs/ directory: mkdir -p chtc_logs
universe   = docker
docker_image = pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime
executable = chtc/mnist_ddpm_unet.sh

transfer_input_files    = hw3_code.tar.gz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = results_mnist_ddpm_unet.tar.gz

log    = chtc_logs/mnist_ddpm_unet_$(Cluster).log
output = chtc_logs/mnist_ddpm_unet_$(Cluster).out
error  = chtc_logs/mnist_ddpm_unet_$(Cluster).err

request_gpus   = 1
request_cpus   = 4
request_memory = 16GB
request_disk   = 20GB
+WantGPULab = true
+GPUJobLength = "long"
require_gpus = (Capability >= 7.0) && (GlobalMemoryMb >= 16000)

queue
